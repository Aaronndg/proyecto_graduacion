# Plantilla del archivo .env para el servidor (producción).
# En el servidor: copie este archivo como .env, complete los valores entre <...> y ejecute «php artisan key:generate».
# Nunca suba el .env real a GitHub.

APP_NAME="NEXO"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://<su-dominio>

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<nombre de la base de datos>
DB_USERNAME=<usuario de la base de datos>
DB_PASSWORD=<contraseña de la base de datos>

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=<correo de Gmail>
MAIL_PASSWORD=<contraseña de aplicación de 16 letras>
MAIL_FROM_ADDRESS=<correo de Gmail>
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# «Continuar con Google»: agregue https://<su-dominio>/auth/google/callback en la consola de Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Primer administrador: lo crea «php artisan migrate --seed --force». Después borre ADMIN_CONTRASENA.
ADMIN_NOMBRE="Administrador"
ADMIN_CORREO=<correo del administrador>
ADMIN_CONTRASENA=<mínimo 8 caracteres, con letras y números>

# Respaldos diarios de la base de datos que se conservan.
RESPALDOS_CONSERVAR=14
